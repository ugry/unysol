# Unysol QA Environment Variables — EXAMPLE
# Copy to .env.qa and fill in real values for local QA

# PostgreSQL
POSTGRES_USER=unysol
POSTGRES_PASSWORD=change_me
POSTGRES_DB=unysol

# Backend
DATABASE_URL=postgres://unysol:change_me@db:5432/unysol?sslmode=disable
JWT_SECRET=change_me_32_chars_minimum

# Mailpit (local test SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@unysol.test
SMTP_FROM_NAME=Unysol QA
