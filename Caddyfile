# Caddyfile — QA Reverse Proxy (mirrors production ALB routing)
# Production: ALB routes /api/* → backend:8080, everything else → frontend:5173

:80 {
    # API routes → backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Health check endpoints → backend
    handle /health {
        reverse_proxy backend:8080
    }

    # WebSocket → backend
    handle /ws/* {
        reverse_proxy backend:8080
    }

    # Everything else → frontend
    handle {
        reverse_proxy frontend:5173
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
