# Unysol — Environment Variables
# Copy this file to .env for local development

# Docker Compose
POSTGRES_USER=unysol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unysol
GRAFANA_ADMIN_PASSWORD=change-me

# Backend
PORT=8080
ENVIRONMENT=development
DATABASE_URL=postgres://unysol:change-me@db:5432/unysol?sslmode=disable
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_AUTH=10

# Plan Limits
PLAN_FREE_MAX_TRUCKS=3
PLAN_FREE_MAX_USERS=3
PLAN_PRO_MAX_TRUCKS=10
PLAN_PRO_MAX_USERS=10
PLAN_PREMIUM_MAX_TRUCKS=50
PLAN_PREMIUM_MAX_USERS=30

# Country profile (single-market deployment; default TR)
COUNTRY=TR
BASE_URL=https://unysol.com

# Email (sysadmin-managed; no admin panel)
EMAIL_METHOD=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@unysol.com
RESEND_API_KEY=

# Stripe (sysadmin-managed via env)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
