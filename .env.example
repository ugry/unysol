# Unysol Backend Configuration
PORT=8080
ENVIRONMENT=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unysol?sslmode=disable
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_AUTH=10

# Plan Limits
PLAN_FREE_MAX_TRUCKS=1
PLAN_FREE_MAX_USERS=3
PLAN_PRO_MAX_TRUCKS=5
PLAN_PRO_MAX_USERS=10
PLAN_PREMIUM_MAX_TRUCKS=50
PLAN_PREMIUM_MAX_USERS=30
